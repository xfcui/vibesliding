# VibeSliding Configuration
# Priority: CLI flags > env vars (OPENROUTER_API_KEY, MINIMAX_API_KEY, etc.) > this file

provider = openrouter
max_concurrent = 36
# proxy = socks5://127.0.0.1:1080

[openrouter]
api_key = your-openrouter-api-key-here
# Optional: Management API key for GET /credits — https://openrouter.ai/settings/management-keys
# management_api_key = your-openrouter-management-key-here
# Any model from https://openrouter.ai/api/v1/images/models (e.g. openai/gpt-image-2.5-sunburst)
img_model = google/gemini-3-pro-image-preview
txt_model = anthropic/claude-opus-4.6
use_proxy = true

[volcengine]
api_key = your-ark-api-key-here
img_model = doubao-seedream-5-0-260128
txt_model = doubao-1-5-pro-32k-250115
use_proxy = false

[minimax]
api_key = your-minimax-api-key-here
img_model = image-01
txt_model = MiniMax-M3
use_proxy = false
# Present TTS (python -m src.present.cli) — optional overrides
# tts_model = speech-2.8-hd
# tts_voice = Chinese (Mandarin)_Lyrical_Voice
